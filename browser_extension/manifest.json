{
  "manifest_version": 3,
  "name": "BilibiliHarvest",
  "description": "Send Bilibili video URLs to local BilibiliHarvest API for subtitle extraction.",
  "version": "0.3.0",
  "permissions": ["storage", "alarms", "activeTab", "tabs", "clipboardWrite", "sidePanel", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BilibiliHarvest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
